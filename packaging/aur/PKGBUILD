# Maintainer: CoderZone BD <PLACEHOLDER@example.invalid>
#
# TEMPLATE (see README.md): builds the desktop app, the daemon, the command
# line and the native messaging host from the release source archive.
# .github/scripts/package-manifests.mjs fills in the version and checksum
# for each release.

pkgname=whoosh
# The release version; pkgver may not contain "-" (1.0.0-beta.1 -> 1.0.0_beta.1).
_version=0.0.1
pkgver=${_version//-/_}
pkgrel=1
pkgdesc='Fast, open-source download manager'
arch=('x86_64' 'aarch64')
url='https://github.com/coderzonebd/whoosh-download-manager'
# Desktop app GPL-3.0-or-later; engine, protocol and native host Apache-2.0.
license=('GPL-3.0-or-later' 'Apache-2.0')
depends=(
  'cairo'
  'gcc-libs'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libayatana-appindicator'
  'libsoup3'
  'pango'
  'webkit2gtk-4.1'
)
makedepends=('cargo' 'nodejs' 'pnpm')
# makepkg's LTO flags break Rust linking; the release profile already uses thin LTO.
options=('!lto')
source=("$pkgname-$_version.tar.gz::$url/releases/download/v$_version/whoosh-$_version-source.tar.gz")
sha256sums=('SKIP')

_appid=com.coderzonebd.whoosh

prepare() {
  cd "whoosh-$_version"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
  pnpm install --frozen-lockfile
}

build() {
  cd "whoosh-$_version"
  export RUSTUP_TOOLCHAIN=stable
  # Absolute: the Tauri CLI runs cargo from apps/desktop/src-tauri.
  export CARGO_TARGET_DIR="$srcdir/whoosh-$_version/target"
  # Frontend + Rust binary, no Tauri bundles. Arch's nodejs has no corepack,
  # so call pnpm directly instead of the config's "corepack pnpm build".
  (
    cd apps/desktop
    pnpm tauri build --ci --no-bundle \
      --config '{"build":{"beforeBuildCommand":"pnpm build"}}' -- --frozen
  )
  # The app starts whoosh-daemon from PATH when it is not next to it.
  cargo build --release --frozen -p whoosh-daemon -p whoosh-cli -p whoosh-nmhost
}

check() {
  cd "whoosh-$_version"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen -p whoosh-nmhost -p whoosh-core -p whoosh-proto
}

package() {
  cd "whoosh-$_version"

  install -Dm755 target/release/whoosh-desktop "$pkgdir/usr/bin/whoosh-desktop"
  install -Dm755 target/release/whoosh-nmhost "$pkgdir/usr/bin/whoosh-nmhost"
  install -Dm755 target/release/whoosh-daemon "$pkgdir/usr/bin/whoosh-daemon"
  install -Dm755 target/release/whoosh "$pkgdir/usr/bin/whoosh"

  install -Dm644 "packaging/linux/$_appid.desktop" "$pkgdir/usr/share/applications/$_appid.desktop"
  install -Dm644 "packaging/linux/$_appid.metainfo.xml" "$pkgdir/usr/share/metainfo/$_appid.metainfo.xml"
  local icons=apps/desktop/src-tauri/icons
  install -Dm644 "$icons/32x32.png" "$pkgdir/usr/share/icons/hicolor/32x32/apps/$_appid.png"
  install -Dm644 "$icons/128x128.png" "$pkgdir/usr/share/icons/hicolor/128x128/apps/$_appid.png"
  install -Dm644 "$icons/128x128@2x.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/$_appid.png"

  # System-wide native messaging manifests (store extension IDs included)
  # and store offers: the same files the .deb and .rpm install, generated
  # from packaging/browsers/extension-ids.json.
  local tauri=apps/desktop/src-tauri dest src
  while read -r dest src; do
    install -Dm644 "$tauri/$src" "$pkgdir$dest"
  done < "$tauri/installer/linux/files.txt"

  install -Dm644 LICENSE.md LICENSE-APACHE LICENSE-GPL -t "$pkgdir/usr/share/licenses/$pkgname/"
}
