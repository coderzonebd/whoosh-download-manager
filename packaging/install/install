echo `# <#` >/dev/null
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Installs Whoosh Download Manager on any system, with one script that works out the rest:
#
#   Linux, macOS:  curl -fsSL https://raw.githubusercontent.com/coderzonebd/whoosh-download-manager/pub/packaging/install/install | sh
#   Windows:       irm https://raw.githubusercontent.com/coderzonebd/whoosh-download-manager/pub/packaging/install/install | iex
#
# The same file is a POSIX shell script and a PowerShell script. The first line is the switch:
# sh runs `echo` with an empty command substitution and goes on with the shell part below,
# which ends with `exit`; PowerShell reads "echo `#" and then a block comment that hides the
# whole shell part, up to the line that closes it, and runs the PowerShell part after it.
# (So the shell part must never contain the two characters that close a PowerShell block comment.)
#
# - Windows: winget when it is there (`winget install --id CoderZoneBD.WDM`), else the release's
#   per-user installer (no administrator rights).
# - macOS: Homebrew's cask when Homebrew is there, else the .dmg into /Applications.
# - Debian, Ubuntu, Mint…: the WDM apt repository when it is set up (updates also come with
#   `apt upgrade`), else the release's .deb through apt.
# - Fedora, openSUSE…: the WDM rpm repository, else the release's .rpm through dnf/zypper.
# - Any other Linux: the AppImage in ~/.local/bin, with a menu entry.
#
# Every download is checked against the release's SHA256SUMS; the app keeps itself up to date
# afterwards. WDM_VERSION=v1.2.3 installs that release; WDM_CHANNEL=beta prefers pre-releases.

# ------------------------------------------------------------------ Linux and macOS (sh)
set -eu

REPO="coderzonebd/whoosh-download-manager"
# The signed apt/rpm repository, hosted by Cloudsmith. Set a variable to "" to skip it; when the
# repository cannot serve the package, the release's own .deb/.rpm is installed instead.
CLOUDSMITH="https://dl.cloudsmith.io/public/coderzonebd/whoosh-download-manager"
APT_REPO="${WDM_APT_REPO-$CLOUDSMITH/deb/any-distro}"
RPM_REPO="${WDM_RPM_REPO-$CLOUDSMITH/rpm/any-distro/any-version/\$basearch}"
REPO_KEY="${WDM_REPO_KEY-$CLOUDSMITH/gpg.35EDBBE261FE7235.key}"
CASK="coderzonebd/tap/whoosh-download-manager"

say() { printf '%s\n' "wdm: $*"; }
die() { printf '%s\n' "wdm: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

if have curl; then fetch() { curl -fsSL --retry 3 -o "$2" "$1"; }; get() { curl -fsSL --retry 3 "$1"; }
elif have wget; then fetch() { wget -qO "$2" "$1"; }; get() { wget -qO- "$1"; }
else die "needs curl or wget"; fi

SUDO=""
if [ "$(id -u)" -ne 0 ]; then
  if have sudo; then SUDO="sudo"; elif have doas; then SUDO="doas"; fi
fi
root() { [ -n "$SUDO" ] || [ "$(id -u)" -eq 0 ] || die "needs root for this step (sudo or doas)"; $SUDO "$@"; }

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT INT TERM

# The release tag: WDM_VERSION, else the newest stable release, else (before the first stable
# release, or with WDM_CHANNEL=beta) the newest pre-release.
release_tag() {
  if [ -n "${WDM_VERSION-}" ]; then printf '%s\n' "$WDM_VERSION"; return; fi
  api="https://api.github.com/repos/$REPO/releases"
  if [ "${WDM_CHANNEL-}" != "beta" ]; then
    tag="$(get "$api/latest" 2>/dev/null | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -n 1)" || tag=""
    [ -n "$tag" ] && { printf '%s\n' "$tag"; return; }
  fi
  get "$api?per_page=20" | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -n 1
}

# Downloads release asset $1 into $TMP and checks it against SHA256SUMS.
asset() {
  base="https://github.com/$REPO/releases/download/$TAG"
  [ -f "$TMP/SHA256SUMS" ] || fetch "$base/SHA256SUMS" "$TMP/SHA256SUMS"
  fetch "$base/$1" "$TMP/$1"
  want="$(awk -v f="$1" '{ n = $2; sub(/^\*/, "", n); if (n == f) print $1 }' "$TMP/SHA256SUMS")"
  [ -n "$want" ] || die "$1 is not in SHA256SUMS"
  if have sha256sum; then got="$(sha256sum "$TMP/$1" | cut -d' ' -f1)"
  else got="$(shasum -a 256 "$TMP/$1" | cut -d' ' -f1)"; fi
  [ "$got" = "$want" ] || die "$1: checksum mismatch, nothing was installed"
}

# Homebrew carries full releases only (the tap gets no betas), so a pinned version or the beta
# channel goes straight to the .dmg, and so does a Homebrew that cannot install it.
use_brew() { have brew && [ -z "${WDM_VERSION-}" ] && [ "${WDM_CHANNEL-}" != beta ]; }

install_macos() {
  if use_brew; then
    say "installing with Homebrew"
    if brew install --cask "$CASK"; then return; fi
    say "Homebrew could not install it (the tap has full releases only); installing the .dmg instead"
  fi
  TAG="$(release_tag)"; [ -n "$TAG" ] || die "no release found"
  v="${TAG#v}"
  dmg="Whoosh-Download-Manager_${v}_universal.dmg"
  say "downloading $dmg"
  asset "$dmg"
  mnt="$TMP/mnt"; mkdir -p "$mnt"
  hdiutil attach -nobrowse -quiet -mountpoint "$mnt" "$TMP/$dmg"
  dest="/Applications"; [ -w "$dest" ] || dest="$HOME/Applications"; mkdir -p "$dest"
  rm -rf "$dest/Whoosh Download Manager.app"
  cp -R "$mnt/Whoosh Download Manager.app" "$dest/"
  hdiutil detach -quiet "$mnt"
  say "installed in $dest; open it from Launchpad or Spotlight"
}

arch_deb() { case "$(uname -m)" in x86_64|amd64) echo amd64 ;; aarch64|arm64) echo arm64 ;; *) die "no Linux build for $(uname -m)" ;; esac; }
arch_rpm() { case "$(uname -m)" in x86_64|amd64) echo x86_64 ;; aarch64|arm64) echo aarch64 ;; *) die "no Linux build for $(uname -m)" ;; esac; }

# Each step returns on failure itself: `set -e` is off inside a function called from `if`.
apt_from_repo() {
  say "adding the WDM apt repository"
  fetch "$REPO_KEY" "$TMP/wdm.asc" || return 1
  root install -d -m 0755 /etc/apt/keyrings || return 1
  root sh -c "gpg --dearmor < '$TMP/wdm.asc' > /etc/apt/keyrings/whoosh-download-manager.gpg" 2>/dev/null \
    || root cp "$TMP/wdm.asc" /etc/apt/keyrings/whoosh-download-manager.asc || return 1
  key=/etc/apt/keyrings/whoosh-download-manager.gpg
  [ -f "$key" ] || key=/etc/apt/keyrings/whoosh-download-manager.asc
  echo "deb [signed-by=$key] $APT_REPO any-version main" \
    | root tee /etc/apt/sources.list.d/whoosh-download-manager.list >/dev/null || return 1
  root apt-get update -o Dir::Etc::sourcelist=sources.list.d/whoosh-download-manager.list \
    -o Dir::Etc::sourceparts=- -o APT::Get::List-Cleanup=0 || return 1
  root apt-get install -y whoosh-download-manager
}

install_apt() {
  if [ -n "$APT_REPO" ] && [ -n "$REPO_KEY" ]; then
    if apt_from_repo; then return; fi
    say "the apt repository did not work; installing the release's .deb instead"
    root rm -f /etc/apt/sources.list.d/whoosh-download-manager.list \
      /etc/apt/keyrings/whoosh-download-manager.gpg /etc/apt/keyrings/whoosh-download-manager.asc
  fi
  TAG="$(release_tag)"; [ -n "$TAG" ] || die "no release found"
  deb="Whoosh-Download-Manager_${TAG#v}_$(arch_deb).deb"
  say "downloading $deb"
  asset "$deb"
  chmod 0644 "$TMP/$deb"
  root apt-get install -y "$TMP/$deb"
}

rpm_from_repo() { # <package manager> <repo directory>
  say "adding the WDM rpm repository"
  printf '[whoosh-download-manager]\nname=Whoosh Download Manager\nbaseurl=%s\nenabled=1\ngpgcheck=1\nrepo_gpgcheck=1\ngpgkey=%s\n' \
    "$RPM_REPO" "$REPO_KEY" | root tee "$2/whoosh-download-manager.repo" >/dev/null || return 1
  if [ "$1" = zypper ]; then root zypper --non-interactive --gpg-auto-import-keys install whoosh-download-manager
  else root "$1" install -y whoosh-download-manager; fi
}

install_rpm() {
  pm="$1"
  if [ -n "$RPM_REPO" ] && [ -n "$REPO_KEY" ]; then
    dir=/etc/yum.repos.d; [ "$pm" = zypper ] && dir=/etc/zypp/repos.d
    if rpm_from_repo "$pm" "$dir"; then return; fi
    say "the rpm repository did not work; installing the release's .rpm instead"
    root rm -f "$dir/whoosh-download-manager.repo"
  fi
  TAG="$(release_tag)"; [ -n "$TAG" ] || die "no release found"
  v="${TAG#v}"
  rpm="Whoosh-Download-Manager-${v}-1.$(arch_rpm).rpm"
  base="https://github.com/$REPO/releases/download/$TAG"
  fetch "$base/SHA256SUMS" "$TMP/SHA256SUMS"
  if ! grep -q "$rpm" "$TMP/SHA256SUMS"; then
    # Pre-releases ship no .rpm (RPM refuses the `-` of a pre-release version).
    say "$TAG has no .rpm; installing the AppImage instead"
    install_appimage
    return
  fi
  say "downloading $rpm"
  asset "$rpm"
  if [ "$pm" = zypper ]; then root zypper --non-interactive install --allow-unsigned-rpm "$TMP/$rpm"
  else root "$pm" install -y "$TMP/$rpm"; fi
}

install_appimage() {
  TAG="$(release_tag)"; [ -n "$TAG" ] || die "no release found"
  case "$(uname -m)" in x86_64|amd64) a=amd64 ;; aarch64|arm64) a=aarch64 ;; *) die "no Linux build for $(uname -m)" ;; esac
  img="Whoosh-Download-Manager_${TAG#v}_${a}.AppImage"
  say "downloading $img"
  asset "$img"
  bin="$HOME/.local/bin"; mkdir -p "$bin" "$HOME/.local/share/applications"
  install -m 0755 "$TMP/$img" "$bin/Whoosh-Download-Manager.AppImage"
  cat > "$HOME/.local/share/applications/com.coderzonebd.whoosh.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Whoosh Download Manager
Exec=$bin/Whoosh-Download-Manager.AppImage
Icon=com.coderzonebd.whoosh
Categories=Network;FileTransfer;
DESKTOP
  say "installed $bin/Whoosh-Download-Manager.AppImage"
}

# WDM_DRY_RUN=1: say how it would install, change nothing (CI checks the script this way).
if [ "${WDM_DRY_RUN-}" = 1 ]; then
  install_macos() { if use_brew; then echo "wdm: would install with Homebrew, else the .dmg"; else echo "wdm: would install the .dmg"; fi; }
  install_apt() { echo "wdm: would install with apt"; }
  install_rpm() { echo "wdm: would install with $1"; }
  install_appimage() { echo "wdm: would install the AppImage"; }
fi

case "$(uname -s)" in
  Darwin) install_macos ;;
  Linux)
    if have apt-get && have dpkg; then install_apt
    elif have dnf; then install_rpm dnf
    elif have zypper; then install_rpm zypper
    elif have yum; then install_rpm yum
    else install_appimage; fi
    ;;
  *) die "this script is for Linux and macOS; on Windows run: winget install --id CoderZoneBD.WDM -e" ;;
esac
say "done. Whoosh Download Manager keeps itself up to date."
exit 0
#> > $null

# ------------------------------------------------------------------ Windows (PowerShell)
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'

$Repo = 'coderzonebd/whoosh-download-manager'
$WingetId = 'CoderZoneBD.WDM'

function Say($m) { Write-Host "wdm: $m" }

function Get-ReleaseTag {
    if ($env:WDM_VERSION) { return $env:WDM_VERSION }
    $api = "https://api.github.com/repos/$Repo/releases"
    if ($env:WDM_CHANNEL -ne 'beta') {
        try { return (Invoke-RestMethod "$api/latest").tag_name } catch { }
    }
    $all = Invoke-RestMethod "$api`?per_page=20"
    if (-not $all) { throw 'no release found' }
    return $all[0].tag_name
}

function Install-WithWinget {
    $winget = Get-Command winget -ErrorAction SilentlyContinue
    if (-not $winget -or $env:WDM_VERSION -or $env:WDM_CHANNEL -eq 'beta') { return $false }
    Say 'installing with winget'
    & winget install --id $WingetId --exact --source winget --accept-source-agreements --accept-package-agreements
    # 0 = installed; -1978335189 = already installed and up to date.
    return ($LASTEXITCODE -eq 0 -or $LASTEXITCODE -eq -1978335189)
}

function Install-FromRelease {
    $tag = Get-ReleaseTag
    $version = $tag.TrimStart('v')
    $arch = if ($env:PROCESSOR_ARCHITECTURE -eq 'ARM64' -or $env:PROCESSOR_ARCHITEW6432 -eq 'ARM64') { 'arm64' } else { 'x64' }
    $name = "Whoosh-Download-Manager_${version}_${arch}-setup.exe"
    $base = "https://github.com/$Repo/releases/download/$tag"
    $tmp = Join-Path ([IO.Path]::GetTempPath()) ("wdm-" + [guid]::NewGuid())
    New-Item -ItemType Directory -Path $tmp | Out-Null
    try {
        Say "downloading $name"
        # GitHub serves release assets as application/octet-stream, for which
        # Windows PowerShell 5.1 returns .Content as bytes, not text.
        $body = (Invoke-WebRequest "$base/SHA256SUMS" -UseBasicParsing).Content
        $sums = if ($body -is [byte[]]) { [Text.Encoding]::UTF8.GetString($body) } else { [string]$body }
        $want = $null
        foreach ($line in ($sums -split "`r?`n")) {
            if ($line -match "^([0-9a-fA-F]{64})\s+\*?$([regex]::Escape($name))\s*$") { $want = $Matches[1]; break }
        }
        if (-not $want) { throw "$name is not in SHA256SUMS" }
        $file = Join-Path $tmp $name
        Invoke-WebRequest "$base/$name" -OutFile $file -UseBasicParsing
        $got = (Get-FileHash $file -Algorithm SHA256).Hash
        if ($got -ne $want.ToUpperInvariant()) { throw "$name`: checksum mismatch, nothing was installed" }
        Say 'installing (per user, no administrator rights needed)'
        $p = Start-Process -FilePath $file -ArgumentList '/S' -Wait -PassThru
        if ($p.ExitCode -ne 0) { throw "the installer stopped with code $($p.ExitCode)" }
    } finally {
        Remove-Item -Recurse -Force $tmp -ErrorAction SilentlyContinue
    }
}

# $env:WDM_DRY_RUN = "1": say how it would install, change nothing (CI checks the script this way).
if ($env:WDM_DRY_RUN -eq '1') {
    if (Get-Command winget -ErrorAction SilentlyContinue) { Say 'would install with winget' } else { Say 'would install the per-user installer' }
    return
}
if (-not (Install-WithWinget)) { Install-FromRelease }
Say 'done. Whoosh Download Manager keeps itself up to date; find it in the Start menu.'
