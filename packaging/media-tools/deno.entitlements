<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Deno runs V8, which compiles JavaScript to machine code at run time. Under
  the hardened runtime (Developer ID signing) that needs JIT memory; these are
  the entitlements Deno's own signed builds carry. Used by release.yml only
  when Developer ID signing is configured; untested until then.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
