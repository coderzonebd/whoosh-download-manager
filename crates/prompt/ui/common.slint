// What the native windows share: the app's colours, its icons, and the
// small pieces (button, category tile, labels) both windows are built of.

import { Spinner } from "std-widgets.slint";

// The app's design tokens (packages/design-tokens/src/tokens.css), light and dark.
export global Theme {
    in property <bool> dark;
    in property <bool> rtl;
    out property <color> surface: dark ? #14204a : #ffffff;
    out property <color> bg: dark ? #0c1533 : #ffffff;
    out property <color> border: dark ? #1d2b57 : #e1e8fa;
    out property <color> text: dark ? #eef2ff : #10204d;
    out property <color> muted: dark ? #aab8de : #47557e;
    out property <color> subtle: dark ? #94a3cf : #5a678f;
    out property <color> accent: dark ? #5b93ff : #2563eb;
    out property <color> primary: #ffd84d;
    out property <color> primary-text: #10204d;
    out property <color> primary-hover: #ffe074;
    out property <color> primary-edge: dark ? #050a1c : #10204d;
    out property <color> hover: dark ? #121d44 : #f1f5ff;
    out property <color> pressed: dark ? #1a2858 : #e4ecff;
    out property <color> accent-subtle: dark ? #16275a : #e6eeff;
    out property <color> border-strong: dark ? #6577ad : #7381a8;
    out property <color> sunken: dark ? #081028 : #f4f7ff;
    out property <color> selected: dark ? #1a2858 : #e4ecff;
    out property <color> accent-text: dark ? #8fb5ff : #1746b3;
    out property <color> focus: dark ? #8fb5ff : #2563eb;
    out property <color> success: dark ? #5bd99b : #126b39;
    out property <color> warning: dark ? #f5b764 : #874900;
    out property <color> danger: dark ? #ff8a92 : #ad222b;
    out property <color> danger-subtle: dark ? #3a161a : #fde8e9;
    out property <color> track: dark ? #1d2b57 : #e1e8fa;
    out property <color> bar: dark ? #3ccf86 : #178547;
    out property <color> info: dark ? #a586ff : #7445d6;
    out property <color> warning-tint: dark ? #f0a33a : #c46a00;
    out property <color> neutral: dark ? #6f7fae : #7381a8;
    out property <TextHorizontalAlignment> start: rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
}

