export struct Btn {
    id: string,
    label: string,
    primary: bool,
    enabled: bool,
}

// A row of facts: two side by side, or one across (`label2` empty).
export struct Fact {
    label: string,
    value: string,
    label2: string,
    value2: string,
}

export struct Sub {
    label: string,
    checked: bool,
}

export component Icon inherits Path {
    in property <string> name;
    in property <color> tint;
    width: 16px;
    height: 16px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: name;
    stroke: tint;
    stroke-width: 1.75px;
    fill: transparent;
    accessible-role: none;
}

// The category tile of the file (`FileIcon.svelte`).
export component Tile inherits Rectangle {
    in property <string> category;
    in property <length> size: 42px;
    property <color> tint: category == "video" ? Theme.info
        : category == "music" ? Theme.danger
        : category == "documents" ? Theme.accent
        : category == "compressed" ? Theme.warning-tint
        : category == "programs" ? Theme.bar
        : category == "images" ? Theme.bar.mix(Theme.accent, 55%)
        : Theme.neutral;
    width: root.size;
    height: root.size;
    border-radius: root.size > 30px ? 10px : 6px;
    background: tint.with-alpha(0.13);
    Icon {
        width: root.size * 0.52;
        height: root.size * 0.52;
        tint: root.tint;
        name: category == "video" ? Icons.video
            : category == "music" ? Icons.music
            : category == "documents" ? Icons.document
            : category == "compressed" ? Icons.archive
            : category == "programs" ? Icons.app
            : category == "images" ? Icons.image
            : Icons.file;
    }
}

// A button in the app's style (`.vy-btn`): the main action yellow, the rest
// outlined; `checkable` ones make a two-way choice ("Video" / "Audio only").
export component Button inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> primary;
    in property <bool> enabled: true;
    in property <bool> checkable;
    in property <bool> checked;
    // What a screen reader says (an icon-only button has no text).
    in property <string> a11y-label: root.text;
    callback clicked();
    min-width: max(root.text == "" ? 34px : 64px, label.preferred-width + (root.icon == "" ? 28px : 50px));
    min-height: 34px;
    border-radius: 8px;
    background: !root.enabled ? (root.primary ? Theme.primary.with-alpha(0.45) : Theme.surface)
        : root.primary ? (touch.pressed ? Theme.primary-hover.darker(8%) : touch.has-hover ? Theme.primary-hover : Theme.primary)
        : root.checked ? Theme.accent-subtle
        : touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : Theme.surface;
    border-width: 1px;
    border-color: root.primary ? Theme.primary-edge : root.checked ? Theme.accent : Theme.border-strong;
    opacity: root.enabled ? 1 : 0.55;
    accessible-role: button;
    accessible-label: root.a11y-label;
    accessible-enabled: root.enabled;
    accessible-checkable: root.checkable;
    accessible-checked: root.checked;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            root.clicked();
        }
    }
    HorizontalLayout {
        alignment: center;
        spacing: 6px;
        padding-left: 12px;
        padding-right: 12px;
        if root.icon != "": Icon {
            name: root.icon;
            tint: label.color;
            width: 15px;
            height: 15px;
            y: (parent.height - self.height) / 2;
        }
        label := Text {
            text: root.text;
            color: root.primary ? Theme.primary-text : root.checked ? Theme.accent : Theme.text;
            font-size: 13px;
            font-weight: root.primary ? 600 : 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if focus.has-focus: Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 11px;
        border-width: 2px;
        border-color: Theme.focus;
    }
}

export component Label inherits Text {
    color: Theme.text;
    font-size: 13px;
    font-weight: 600;
    horizontal-alignment: Theme.start;
}

export component Hint inherits Text {
    color: Theme.muted;
    font-size: 12px;
    wrap: word-wrap;
    horizontal-alignment: Theme.start;
}

// A line with an icon: "Can pause and resume", "Pausing restarts this download".
export component Status inherits HorizontalLayout {
    in property <string> icon;
    in property <color> tint;
    in property <string> text;
    in property <bool> busy;
    spacing: 6px;
    alignment: Theme.rtl ? end : start;
    if busy && !Theme.rtl: Spinner { width: 14px; height: 14px; indeterminate: true; }
    if !busy && icon != "" && !Theme.rtl: Icon { name: icon; tint: tint; width: 14px; height: 14px; y: (parent.height - self.height) / 2; }
    Text {
        text: root.text;
        color: tint;
        font-size: 12px;
        wrap: word-wrap;
        horizontal-alignment: Theme.start;
        vertical-alignment: center;
    }
    if !busy && icon != "" && Theme.rtl: Icon { name: icon; tint: tint; width: 14px; height: 14px; y: (parent.height - self.height) / 2; }
    if busy && Theme.rtl: Spinner { width: 14px; height: 14px; indeterminate: true; }
}

