{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whoosh",
  "version": "0.1.2",
  "identifier": "com.coderzonebd.whoosh",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Whoosh Download Manager",
        "width": 1240,
        "height": 780,
        "minWidth": 640,
        "minHeight": 420,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["whoosh"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZENEQ3Q0I1MkI4RDc2NjcKUldSbmRvMHJ0WHhOL1RVU01ES2pUUVNUTnZuRytaclQ5cFl4MEM1WGpqQUxSd1dBV1dVYXpGMjkK",
      "endpoints": ["https://raw.githubusercontent.com/coderzonebd/whoosh-download-manager/updater/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "publisher": "CoderZone BD",
    "copyright": "Copyright © 2026 CoderZone BD and contributors",
    "shortDescription": "Fast, open-source download manager",
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
