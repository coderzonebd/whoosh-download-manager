{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whoosh Download Manager",
  "version": "1.0.0-beta.1",
  "identifier": "com.coderzonebd.whoosh",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Whoosh Download Manager"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "publisher": "CoderZone BD",
    "copyright": "Copyright © 2026 CoderZone BD and contributors",
    "shortDescription": "Fast, open-source download manager",
    "license": "GPL-3.0-or-later",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "android": {
      "minSdkVersion": 30
    }
  }
}
