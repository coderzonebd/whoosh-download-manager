<?xml version="1.0" encoding="utf-8"?>
<!--
  Release builds: every connection to the outside is HTTPS-only, as Android's default. The one
  exception is this phone itself: the UI reaches the download engine running inside the app over
  ws://127.0.0.1 (a token guards it; nothing leaves the phone).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
